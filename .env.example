# DeepSeek API key used for label analysis.
DEEPSEEK_API_KEY=

# Secret used to sign the per-browser quota cookie. Required in production.
QUOTA_COOKIE_SECRET=

# Region restriction. Set GEO_RESTRICTION_ENABLED=false to allow every country.
# GEO_ALLOWED_COUNTRIES is a comma-separated list of ISO country codes.
GEO_RESTRICTION_ENABLED=true
GEO_ALLOWED_COUNTRIES=HK

# Fail closed (block) when the country header is missing or unknown.
# GEO_FAIL_CLOSED=1

# Daily scan limit. Set DAILY_SCAN_LIMIT_ENABLED=false for unlimited scans.
DAILY_SCAN_LIMIT_ENABLED=true
DAILY_SCAN_LIMIT=10

# Optional: share quota across instances with Upstash Redis.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
